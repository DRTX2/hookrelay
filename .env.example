DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379
# Creates apps (tenants) via POST /v1/apps
ADMIN_TOKEN=change-me
# Only for local dev: lets endpoints point at localhost / docker network
ALLOW_PRIVATE_TARGETS=false
# Comma-separated seconds between attempts (Standard Webhooks default schedule)
RETRY_SCHEDULE=5,300,1800,7200,18000,36000,36000
# Per-tenant ingestion limit (requests/minute)
RATE_LIMIT_PER_MINUTE=600
# Concurrent deliveries per worker process
WORKER_CONCURRENCY=50
# Consecutive failed attempts before an endpoint is disabled
ENDPOINT_DISABLE_AFTER=30
# json | pretty (default: json in production)
LOG_FORMAT=pretty
# Worker Prometheus port
METRICS_PORT=9464
