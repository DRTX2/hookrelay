DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379
# Creates apps (tenants) via POST /v1/apps
ADMIN_TOKEN=change-me
# Only for local dev: lets endpoints point at localhost / docker network
ALLOW_PRIVATE_TARGETS=false
# Comma-separated seconds between attempts (Standard Webhooks default schedule)
RETRY_SCHEDULE=5,300,1800,7200,18000,36000,36000
