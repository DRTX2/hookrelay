{
  "uid": "hookrelay",
  "title": "Hookrelay",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Delivery success rate (10m)",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookrelay_delivery_attempts_total{outcome=\"success\"}[10m])) / clamp_min(sum(rate(hookrelay_delivery_attempts_total{outcome!=\"skipped\"}[10m])), 1e-9)",
          "legendFormat": "success"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue backlog",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookrelay_queue_jobs{state=\"waiting\"})",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "expr": "max(hookrelay_queue_jobs{state=\"delayed\"})",
          "legendFormat": "delayed (retries)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ingestion p95 latency",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hookrelay_http_request_duration_seconds_bucket{route=\"/v1/messages\",method=\"POST\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Messages ingested / s",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookrelay_messages_ingested_total[1m])) by (duplicate)",
          "legendFormat": "duplicate={{duplicate}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Delivery attempts by outcome",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookrelay_delivery_attempts_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Receiver latency (p50 / p95)",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(hookrelay_delivery_attempt_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hookrelay_delivery_attempt_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue jobs by state",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hookrelay_queue_jobs) by (state)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API requests by status",
      "datasource": {
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hookrelay_http_request_duration_seconds_count[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}